{
  "name": "hollow",
  "version": "1.0.0-v1",
  "private": true,
  "type": "module",
  "description": "Hollow V1 — Den første nat. Browserbaseret first-person survival-horror.",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "predev": "node scripts/generate-audio.mjs",
    "prebuild": "node scripts/generate-audio.mjs",
    "pretest": "node scripts/generate-audio.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/generate-audio.mjs && playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
